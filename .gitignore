.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Large or restricted datasets. Keep only documentation/manifests in Git.
data/raw/**
!data/raw/README.md
data/processed/**
!data/processed/README.md
data/benchmarks/**
!data/benchmarks/README.md
*.parquet
*.arrow
*.feather

# Imported release snapshots are local data, not source code.
horus_release_candidate/data/
horus_release_candidate/audit/_*.parquet
dataset_final_completo/data/
# Quarantine includes excerpts of generated texts; keep it with the local corpus.
dataset_final_completo/audit/claude_quarantine.csv

# Model artifacts and caches
checkpoints/
models/
wandb/
mlruns/
*.ckpt
*.pt
*.pth
*.safetensors

# Generated run artifacts
results/logs/**
!results/logs/.gitkeep
results/tmp/
results/runs/
results/theme_validation/
# Prepared LLM prompts contain human corpus excerpts; keep new runs local.
results/theme_llm_600/**/requests.jsonl
results/theme_llm_600_long/**/requests.jsonl
results/theme_llm_second_pass/**/requests.jsonl

